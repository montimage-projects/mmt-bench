# Packet captures never go into git: the corpus manifest lists them by sha256.
# Character classes make each extension case-insensitive (x.Pcap, x.PcapNG, x.CAP).
*.[pP][cC][aA][pP]
*.[pP][cC][aA][pP][nN][gG]
*.[pP][cC][aA][pP].*
*.[pP][cC][aA][pP][nN][gG].*
*.[cC][aA][pP]
*.[cC][aA][pP].*
*.[eE][rR][fF]
*.[eE][rR][fF].*
# Local corpus data (downloaded, generated or private captures).
corpus/data/
# Local-only output: tool-comparison reports stay here until they pass a
# licence and fairness review (AGENTS.md, design decision 1).
local/

# Editors and OS
.idea/
.vscode/
.DS_Store
